# ==============================================================================
# KONFIGURASI BIOFINGER AT-101 & GATEWAY NOTIFIKASI
# ==============================================================================

# IP & Port Mesin Sidik Jari BioFinger AT-101 di LAN Sekolah
BIOFINGER_IP=192.168.1.201
BIOFINGER_PORT=4370
BIOFINGER_COMM_KEY=0
BIOFINGER_TIMEOUT_MS=10000

# Pengaturan Jam Operasional Sekolah (WIB)
# Format Cron: Menit Jam * * Hari(1-6 = Senin-Sabtu)
CUTOFF_CRON_SCHEDULE="15 7 * * 1-6"
TIMEZONE="Asia/Jakarta"
ON_TIME_START="06:00"
ON_TIME_LIMIT="07:00"
CUTOFF_TIME="07:15"

# WhatsApp Gateway Provider (Contoh: Fonnte / Wablas / Generic Webhook)
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_API_TOKEN="YOUR_FONNTE_OR_WABLAS_API_TOKEN"

# Rate Limiting Antrean Pengiriman Pesan (dalam milidetik, 1500ms = 1.5 detik per pesan)
MESSAGE_QUEUE_DELAY_MS=1500

# Nama & Kontak Sekolah
SCHOOL_NAME="SMP / SMA NEGERI 1 BINTANG BANGSA"
SCHOOL_ADMIN_PHONE="0812-3456-7890"

# Opsi Cloud Sync Supabase (Opsional - biarkan kosong jika hanya offline)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
